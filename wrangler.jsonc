{
  // VA Life Bingo: the Worker serves public/ and runs the live game in one Durable Object.
  "name": "awardsnighticebreaker",
  "main": "worker.js",
  "compatibility_date": "2025-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }],
  "observability": { "enabled": true }
}
